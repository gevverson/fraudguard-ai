# Local container pilot configuration. Replace every placeholder before use.
POSTGRES_ADMIN_PASSWORD=replace-with-an-admin-password
FRAUDGUARD_MIGRATOR_DB_PASSWORD=replace-with-a-migrator-password
FRAUDGUARD_APP_DB_PASSWORD=replace-with-an-app-password
FRAUDGUARD_OPERATOR_DB_PASSWORD=replace-with-an-operator-password

FRAUDGUARD_ENVIRONMENT=staging
FRAUDGUARD_AUTH_MODE=required
FRAUDGUARD_DATABASE_URL=postgresql+psycopg://fraudguard_app:replace-with-an-app-password@postgres:5432/fraudguard
FRAUDGUARD_AUTO_CREATE_SCHEMA=false

# JSON mapping supports credential-pepper rotation. Generate each value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
FRAUDGUARD_API_KEY_PEPPERS={"v1":"replace-me"}
FRAUDGUARD_ACTIVE_API_KEY_PEPPER_VERSION=v1
FRAUDGUARD_DATA_PEPPER=replace-me
FRAUDGUARD_DATA_PEPPER_VERSION=v1

FRAUDGUARD_VELOCITY_BACKEND=redis
FRAUDGUARD_VELOCITY_FAILURE_MODE=fail_closed
FRAUDGUARD_REDIS_URL=redis://redis:6379/0
FRAUDGUARD_VELOCITY_WARMUP_SECONDS=300
FRAUDGUARD_REQUEST_MAX_BYTES=65536
FRAUDGUARD_DECISION_RATE_LIMIT_PER_SECOND=50
FRAUDGUARD_DECISION_RATE_LIMIT_BURST=100
